# 复制为 .env 后按需修改。切勿把真实凭据提交到仓库。

# HTTP / Socket.IO 监听端口
PORT=3000
# 监听地址：生产建议 127.0.0.1（由 Nginx 反代）；本地开发用 0.0.0.0 便于手机同网段访问
HOST=127.0.0.1

# development | production | test
NODE_ENV=development

# SQLite 数据库文件路径（相对路径基于 server 包目录）
DB_PATH=./data/jiaowoplay.sqlite

# 用于签名/哈希的密钥，生产必须改成随机长字符串
SESSION_SECRET=change-me-to-a-long-random-string

# 允许的浏览器来源，逗号分隔；开发默认放行 Vite 端口
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# 生产构建后由 Express 直接托管的前端静态目录（留空则不托管，交给 Nginx）
STATIC_DIR=

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# --------------------------------------------------------------- 开发者后台
# 真实密码请只在服务器上填写到 .env，不要写进任何会被提交的文件。
# 下面三项任意一项缺失或仍是占位符，/api/admin 会返回 503（后台视为未启用）。
ADMIN_USER=your-admin-name
ADMIN_PASS=change-me-on-server
# 后台 Token 的签名密钥，与 SESSION_SECRET 分开；生成：openssl rand -hex 32
ADMIN_JWT_SECRET=change-me-to-a-random-secret
# 登录态有效期（秒），默认 7 天
ADMIN_TOKEN_TTL_SECONDS=604800
