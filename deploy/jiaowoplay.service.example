# 交我PLAY systemd 服务示例
#
# 由 deploy/remote-setup.sh 替换占位符后安装到 /etc/systemd/system/jiaowoplay.service：
#   sed -e "s|__NODE_BIN__|/opt/node-v24.22.2/bin/node|g" \
#       -e "s|__APP_DIR__|/opt/jiaowoplay|g" \
#       deploy/jiaowoplay.service.example > /etc/systemd/system/jiaowoplay.service
#   systemctl daemon-reload && systemctl enable --now jiaowoplay
#
# 运行配置（NODE_ENV / PORT / DB_PATH / CORS_ORIGIN / SESSION_SECRET）放在
# __APP_DIR__/.env 里由应用自行加载，不要写进 unit —— systemctl show 会明文读出 Environment。
#
# 安全：用专用低权限用户运行，不要用 root。
#   useradd --system --home-dir /opt/jiaowoplay --shell /usr/sbin/nologin jiaowoplay

[Unit]
Description=JiaoWoPLAY game platform (Node.js + Socket.IO)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jiaowoplay
Group=jiaowoplay
WorkingDirectory=__APP_DIR__
ExecStart=__NODE_BIN__ __APP_DIR__/server/dist/index.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

Environment=NODE_ENV=production

# 加固：ProtectSystem=full 只把 /usr /boot /etc 挂成只读，
# 应用目录与数据目录仍可写（数据目录显式列入 ReadWritePaths）。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__APP_DIR__/server/data
LimitNOFILE=65536

StandardOutput=journal
StandardError=journal
SyslogIdentifier=jiaowoplay

[Install]
WantedBy=multi-user.target
