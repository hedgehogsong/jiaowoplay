# 交我PLAY systemd 服务示例（PM2 的替代方案，二选一）
#
# 部署：
#   sudo cp deploy/jiaowoplay.service.example /etc/systemd/system/jiaowoplay.service
#   修改 Environment 各项后：
#   sudo systemctl daemon-reload && sudo systemctl enable --now jiaowoplay
#
# 安全提示：用专用低权限用户运行，不要用 root。
#   sudo useradd --system --create-home --home-dir /opt/jiaowoplay jiaowoplay

[Unit]
Description=JiaoWoPLAY game platform (Node.js + Socket.IO)
After=network.target

[Service]
Type=simple
User=jiaowoplay
Group=jiaowoplay
WorkingDirectory=/opt/jiaowoplay
ExecStart=/usr/bin/node /opt/jiaowoplay/server/dist/index.js
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=127.0.0.1
Environment=DB_PATH=/opt/jiaowoplay/server/data/jiaowoplay.sqlite
Environment=SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
Environment=CORS_ORIGIN=https://play.example.com
Environment=STATIC_DIR=/opt/jiaowoplay/web/dist
Environment=LOG_LEVEL=info

# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/jiaowoplay/server/data

# 日志进 journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=jiaowoplay

[Install]
WantedBy=multi-user.target
